# Copy this file to .env and fill it in. Never commit .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# In production, list your https origins: https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Manila
# Changing this makes the admin harder to find, e.g. my-desk/
ADMIN_URL=admin/

# --- MySQL (Laragon default: root with an empty password) ---
DB_NAME=ledgerfolio
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Site identity (shown on the Showcase, receipts and emails) ---
SITE_NAME=Ledgerfolio
# Public address of the site. Receipt QR codes and verify links are built from it.
SITE_URL=http://127.0.0.1:8000
OWNER_NAME=Lord
OWNER_TITLE=Freelance Systems Developer
OWNER_EMAIL=
OWNER_PHONE=
OWNER_LOCATION=Philippines
CURRENCY_CODE=PHP
# Show the amount paid on the public verify page? (spec section 13, still open)
VERIFY_SHOW_AMOUNT=True

# --- Email ---
# Development: write emails to var/sent_emails/ as .eml files instead of sending.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# Real sending (example for Gmail with an App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=Ledgerfolio <noreply@localhost>

# --- Blockchain: how Django reaches the node ---
CHAIN_NODE_URL=http://127.0.0.1:8001
# The issuer wallet's private key. Use ONE of these two, never both.
# Create a key file with:  python manage.py generate_issuer_key
ISSUER_KEY_FILE=
ISSUER_PRIVATE_KEY=
# If you ever replace the key, put the OLD public key here (comma-separated
# for several) so receipts signed with it keep verifying.
ISSUER_PREVIOUS_PUBLIC_KEYS=

# --- Blockchain: the node itself (read by `python -m chain_node`) ---
# Network name and minimum difficulty are consensus rules: every node must match.
CHAIN_NETWORK=ledgerfolio-dev
# Difficulty = leading zero bits a block hash needs. 16 is about a second of
# mining on a laptop; each +1 doubles the work.
CHAIN_MIN_DIFFICULTY=16
CHAIN_DIFFICULTY=16
CHAIN_HOST=127.0.0.1
CHAIN_PORT=8001
CHAIN_AUTO_MINE=true
# Other nodes to sync with, comma-separated (leave empty for a single node).
CHAIN_PEERS=
# Optional: only accept transactions signed by these public keys.
CHAIN_ALLOWED_SENDERS=

# --- AI assistant ---
CHAT_RATE_LIMIT=20/min
AI_CONFIDENCE_THRESHOLD=0.55
# Reverse proxies in front of Django: 0 on your PC, 1 on the VPS behind Nginx.
NUM_PROXIES=0
