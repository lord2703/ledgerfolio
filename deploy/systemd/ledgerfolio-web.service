# The Django site under Gunicorn.
#   sudo cp deploy/systemd/ledgerfolio-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ledgerfolio-web
#
# One worker process with four threads keeps memory low: every process loads
# PyTorch for the assistant, and answering a chat message takes ~1 ms. On a
# server with 2 GB of RAM or more, --workers 2 handles more visitors at once.

[Unit]
Description=Ledgerfolio website (Gunicorn)
After=network.target mysql.service ledgerfolio-node.service

[Service]
User=ledgerfolio
Group=www-data
WorkingDirectory=/srv/ledgerfolio
ExecStart=/srv/ledgerfolio/.venv/bin/gunicorn core.wsgi:application \
    --bind 127.0.0.1:8000 --workers 1 --threads 4 --worker-class gthread \
    --timeout 60 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
